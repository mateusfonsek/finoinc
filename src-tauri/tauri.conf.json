{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Finoinc",
  "version": "0.11.0",
  "identifier": "app.finoinc",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Finoinc",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 16 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": { "../locales": "locales" },
    "category": "Finance",
    "copyright": "© 2026 Mateus Fonseca",
    "publisher": "Mateus Fonseca",
    "homepage": "https://github.com/MateusFonseK/finoinc",
    "shortDescription": "Suas finanças, só no seu Mac.",
    "longDescription": "Organize suas finanças pessoais de forma 100% local: importe extratos OFX, categorize com regras e acompanhe tudo num app que não envia seus dados pra lugar nenhum.",
    "fileAssociations": [
      {
        "ext": ["ofx"],
        "name": "Extrato OFX",
        "description": "Extrato bancário OFX",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
